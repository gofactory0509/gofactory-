{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEventBridgeAssume",
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "REPLACE_WITH_ACCOUNT_ID"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:events:us-east-1:REPLACE_WITH_ACCOUNT_ID:rule/gofactory-crawler-weekly"
        }
      }
    }
  ]
}
