# ============================================================
# Go터뷰 환경 변수 예시
# 실제 운영 환경에서는 이 파일을 .env 로 복사 후 값 채워 사용
# ============================================================

# --- 기존 (Streamlit 측 fallback) ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- AWS Bedrock (서비스 기본 백엔드) ---
# EC2에서 IAM Role 사용 시 ACCESS_KEY/SECRET은 불필요
# 로컬 개발 시에만 AWS CLI 프로필 또는 아래 키 사용
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6-20251015-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- OpenRouter (사용자 BYOK 시 자동 사용) ---
# 사용자가 UI에서 본인 키 입력 → 우리 서버는 그 키로 호출
# 아래는 서비스 운영자 기본값(없어도 됨)
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.6
